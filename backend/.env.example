# PWNM configuration template.
# Copy this file to ".env" and fill in real values.  NEVER commit .env.
#
#   Copy-Item .env.example .env      (PowerShell)
#
# --- Database (XAMPP MariaDB defaults: user 'root', empty password) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pwnm
DB_POOL_SIZE=5

# --- Flask session signing key (used from Phase 4) ---
# Generate a real one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# --- Scanning ---
# Default scan cadence (seconds). Live-tunable copy lives in the settings table.
SCAN_INTERVAL_SECONDS=60
